{
  "name": "cashucordauction",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "deploy-commands": "bun src/deploy-commands.ts",
    "start": "bun src/bot.ts",
    "dev": "bun --watch src/bot.ts",
    "test": "bun test",
    "mint:up": "docker compose up mint",
    "mint:down": "docker compose stop mint && docker compose rm -f mint"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^3.1.1",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.44.7",
    "moment": "^2.30.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.3"
  }
}
